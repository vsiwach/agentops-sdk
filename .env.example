# AgentOps Safety Ecosystem - Environment Variables

# OpenAI API Key (required for GPT-4o auditor)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Anthropic API Key (required for Claude agents)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-api-key-here

# AgentOps Secret Key (for cryptographic signatures)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AGENTOPS_SECRET_KEY=your-secret-key-for-signatures

# Database Path (optional, defaults to /data/agent_registry.db)
# DATABASE_PATH=/data/agent_registry.db

# API Configuration (optional)
# API_HOST=0.0.0.0
# API_PORT=8000

# Dashboard Configuration (optional)
# WEB_HOST=0.0.0.0
# WEB_PORT=5173
